# Environment Variables Configuration for Nithu25 Production Backend

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173,https://*.lovable.app,https://*.lovableproject.com

# Database Connection (PostgreSQL with pgvector)
# For local dev without Postgres running, backend falls back to resilient built-in DB storage engine
DATABASE_URL=postgresql://nithu_user:nithu_pass@localhost:5432/nithu25_db?schema=public

# Authentication
JWT_SECRET=super-secret-jwt-key-min-32-chars-nithu25-production-token
JWT_EXPIRES_IN=7d

# Cache & Queues (Redis)
REDIS_URL=redis://localhost:6379

# AI Provider Configuration (OpenAI, Gemini, Ollama or custom compatible endpoint)
AI_PROVIDER=openai_compatible
AI_API_KEY=your-ai-api-key-here
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Object / File Storage (S3 / MinIO / Local)
STORAGE_DRIVER=local
STORAGE_URL=http://localhost:3000/uploads
STORAGE_BUCKET=nithu25-pyqs
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Security
BCRYPT_SALT_ROUNDS=10
